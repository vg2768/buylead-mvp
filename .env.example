# Set these in Netlify: Site configuration > Environment variables. (Do not commit real values.)

# Required. 16+ random characters. Signs the OTP tokens. Generate one with: openssl rand -hex 24
OTP_SECRET=

# Required for the lead inbox at /admin/. The inbox stays disabled without it.
ADMIN_PASSWORD=

# WhatsApp alerts to your own number via Meta's WhatsApp Cloud API (see README)
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_TO=91XXXXXXXXXX
WHATSAPP_TEMPLATE=new_lead_alert
WHATSAPP_TEMPLATE_LANG=en
# WHATSAPP_API_VERSION=v23.0

# OTP delivery. 'dev' writes the code to the Netlify function log (testing only).
# 'webhook' POSTs {phone, code, message} to OTP_WEBHOOK_URL (your SMS provider adapter).
OTP_MODE=dev
OTP_WEBHOOK_URL=

# Optional extra alert channel
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
