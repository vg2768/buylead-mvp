# Copy to .env and fill in. Load with: node --env-file=.env server.js
PORT=3000

# Lead inbox login (required, the inbox stays disabled without a password)
ADMIN_USER=admin
ADMIN_PASSWORD=change-me-to-a-long-random-password

# Where leads are stored (use a persistent disk path in production)
DB_PATH=./leads.db

# OTP delivery. 'dev' prints the code to the server console (testing only).
# 'webhook' POSTs {phone, code, message} to OTP_WEBHOOK_URL: point it at your SMS provider adapter.
OTP_MODE=dev
OTP_WEBHOOK_URL=

# WhatsApp alerts to your own number via Meta's WhatsApp Cloud API (see README).
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_TO=91XXXXXXXXXX
WHATSAPP_TEMPLATE=new_lead_alert
WHATSAPP_TEMPLATE_LANG=en

# Other instant alerts (optional, any combination). With none set, alerts print to the console.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
ALERT_WEBHOOK_URL=
